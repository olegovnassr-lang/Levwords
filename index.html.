function baseHTML(g){let h='<div class="gn"><div class="gh"><b>'+esc(g.t)+'</b><span class="lv">'+esc(g.lv)+'</span></div><div class="gb">'+esc(g.intro)+'</div>';
h+='<div class="cmp">'+g.cmp.map(c=>'<div class="cr"><code>'+esc(c[0])+'</code><div>'+esc(c[1])+'</div><div class="ua">'+esc(c[2])+'</div></div>').join('')+'</div>';
h+=g.secs.map(s=>'<div class="sec"><h4>'+esc(s.h)+' <span class="tr">'+esc(s.tr)+'</span></h4><div class="ua">'+esc(s.tt)+'</div><div class="tg ok">✅ Коли: '+esc(s.use)+'</div><div class="tg no">⛔ Не вживаємо: '+esc(s.no)+'</div>'+s.ex.map(x=>'<div class="ex"><button class="spk sm" data-s="'+esc(x[0])+'" aria-label="Озвучити">🔊</button><div><div class="en2">'+esc(x[0])+'</div><div class="tr">['+esc(x[1])+']</div><div class="ua">'+esc(x[2])+'</div></div></div>').join('')+'</div>').join('')+'</div>';return h}
function renderG(){$('glist').innerHTML=BASE_GR.map(baseHTML).join('')+gr.map((x,i)=>'<div class="gn"><div class="gh"><b>'+esc(x.t)+'</b><span><button class="spk sm" data-e="'+i+'" aria-label="Редагувати">✏️</button><button class="spk sm" data-d="'+i+'" aria-label="Видалити">🗑️</button></span></div><div class="gb">'+esc(x.b)+'</div></div>').join('')}
$('glist').onclick=e=>{const d=e.target.closest('[data-d]'),ed=e.target.closest('[data-e]');if(d){gr.splice(+d.dataset.d,1);eg=-1;$('g_add').textContent='Додати';saveG();renderG()}if(ed){eg=+ed.dataset.e;$('g_t').value=gr[eg].t;$('g_b').value=gr[eg].b;$('g_add').textContent='Зберегти';$('g_t').focus()}};
$('g_add').onclick=()=>{const t=$('g_t').value.trim(),b=$('g_b').value.trim();if(!t)return;if(eg>=0&&gr[eg])gr[eg]={t,b};else gr.push({t,b});eg=-1;$('g_add').textContent='Додати';$('g_t').value='';$('g_b').value='';saveG();renderG()};
/* practice */
let deck=[],idx=0,kn=0,un=0,missed=[],flip=false;
function startDeck(list){const sc='all';let l=list||words().filter(w=>sc==='all'||w.g===sc);deck=l.slice().sort(()=>Math.random()-.5);idx=0;kn=0;un=0;missed=[];show()}

function show(){$('prog').textContent=Math.min(idx+1,deck.length)+'/'+deck.length+' · ✓'+kn+' ✗'+un;const st=$('stage');
if(idx>=deck.length){st.innerHTML='<div class="done card" style="cursor:default"><div class="n">'+kn+' / '+deck.length+'</div><div>Знаю ✓'+kn+' · Не знаю ✗'+un+'</div><br>'+(missed.length?'<button class="btn gold" id="rep">Повторити незнайомі</button> ':'')+'<button class="btn" id="rst">Спочатку</button></div>';
if($('rep'))$('rep').onclick=()=>startDeck(missed.slice());$('rst').onclick=()=>startDeck();return}
const w=deck[idx];flip=false;st.innerHTML='<div class="card" id="card"><span class="stamp k">ЗНАЮ</span><span class="stamp u">НЕ ЗНАЮ</span><div class="big">'+esc(w.em||'🔹')+'</div><div class="w">'+esc(w.en)+'</div><div class="tp">'+(w.tr?'['+esc(w.tr)+']':'')+'</div><div class="a" id="ans">?</div><button class="spk" id="cs" style="margin-top:10px">🔊</button></div>';
const c=$('card');let sx=0,dx=0,drag=false,moved=false;
$('cs').onpointerdown=e=>e.stopPropagation();$('cs').onclick=()=>speak(w.en);
c.onpointerdown=e=>{drag=true;moved=false;sx=e.clientX;c.setPointerCapture(e.pointerId)};
c.onpointermove=e=>{if(!drag)return;dx=e.clientX-sx;if(Math.abs(dx)>6)moved=true;c.style.transform='translateX('+dx+'px) rotate('+dx/18+'deg)';c.querySelector('.k').style.opacity=Math.max(0,dx/100);c.querySelector('.u').style.opacity=Math.max(0,-dx/100)};
c.onpointerup=()=>{if(!drag)return;drag=false;if(dx>90)ans(true);else if(dx<-90)ans(false);else{c.style.transform='';c.querySelector('.k').style.opacity=0;c.querySelector('.u').style.opacity=0;if(!moved){flip=!flip;$('ans').textContent=flip?w.ua+(w.op?'  ↔ '+w.op:''):'?';if(flip)speak(w.en)}}dx=0};
}
function ans(ok){const w=deck[idx];if(!w)return;const c=$('card');if(c){c.style.transition='transform .25s,opacity .25s';c.style.transform='translateX('+(ok?500:-500)+'px) rotate('+(ok?25:-25)+'deg)';c.style.opacity=0}
if(ok)kn++;else{un++;missed.push(w)}idx++;setTimeout(show,230)}
$('bok').onclick=()=>ans(true);$('bno').onclick=()=>ans(false);
render();
</script></body></html>
